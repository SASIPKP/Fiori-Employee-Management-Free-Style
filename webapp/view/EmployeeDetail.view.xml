<mvc:View
    controllerName="com.demo.employee.employeemanagement.controller.EmployeeDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <uxap:ObjectPageLayout
        id="ObjectPageLayout"
        showFooter="{ui>/isEditable}"
        class="sapUiSizeCompact">

        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <HBox alignItems="Center">
                        <Avatar displaySize="L"
                                initials="{path: 'employees>Name', formatter: '.formatInitials'}"
                                displayShape="Circle"
                                class="sapUiSmallMarginEnd"/>
                        <VBox>
                            <Title text="{employees>Name}"/>
                            <ObjectStatus
                                text="{employees>Status}"
                                state="{= ${employees>Status} === 'Active' ? 'Success' : 'Warning'}"/>
                        </VBox>
                    </HBox>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <Title text="{employees>Name}"/>
                </uxap:snappedHeading>

                <uxap:actions>
                    <Button text="Edit"
                            type="Emphasized"
                            press="onEditToggle"
                            visible="{= !${ui>/isEditable} }"/>
                    <Button text="Delete"
                            type="Transparent"
                            press="onDelete"
                            visible="{= !${ui>/isEditable} }"/>
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:sections>
            <uxap:ObjectPageSection title="Personal Information">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <f:SimpleForm layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1" editable="true">
                            <f:content>
                                <Label text="Employee ID"/>
                                <Text text="{employees>EmpId}"/>

                                <Label text="Full Name"/>
                                <VBox>
                                    <Input value="{employees>Name}" visible="{ui>/isEditable}"/>
                                    <Text text="{employees>Name}" visible="{= !${ui>/isEditable} }"/>
                                </VBox>

                                <Label text="Email"/>
                                <VBox>
                                    <Input value="{employees>Email}" visible="{ui>/isEditable}"/>
                                    <Link text="{employees>Email}" visible="{= !${ui>/isEditable} }"/>
                                </VBox>
                            </f:content>
                        </f:SimpleForm>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="Job Details">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <f:SimpleForm layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1" editable="true">
                            <f:content>
                                <Label text="Job Title"/>
                                <VBox>
                                    <Input value="{employees>JobTitle}" visible="{ui>/isEditable}"/>
                                    <Text text="{employees>JobTitle}" visible="{= !${ui>/isEditable} }"/>
                                </VBox>

                                <Label text="Department"/>
                                <VBox>
                                    <Select selectedKey="{employees>Department}" 
                                            visible="{ui>/isEditable}"
                                            items="{departments>/Departments}"
                                            width="100%">
                                        <core:Item key="{departments>key}" text="{departments>text}"/>
                                    </Select>
                                    <Text text="{employees>Department}" visible="{= !${ui>/isEditable} }"/>
                                </VBox>

                                <Label text="Join Date"/>
                                <VBox>
                                    <DatePicker
                                        value="{path:'employees>StartDate', type:'sap.ui.model.type.Date', formatOptions:{style:'medium', source:{pattern:'yyyy-MM-dd'}}}"
                                        visible="{ui>/isEditable}"/>
                                    <Text
                                        text="{path:'employees>StartDate', type:'sap.ui.model.type.Date', formatOptions:{style:'medium', source:{pattern:'yyyy-MM-dd'}}}"
                                        visible="{= !${ui>/isEditable} }"/>
                                </VBox>

                                <Label text="Status"/>
                                <VBox>
                                    <Select selectedKey="{employees>Status}" visible="{ui>/isEditable}" width="100%">
                                        <core:Item key="Active" text="Active"/>
                                        <core:Item key="On Leave" text="On Leave"/>
                                        <core:Item key="Resigned" text="Resigned"/>
                                    </Select>
                                    <Text text="{employees>Status}" visible="{= !${ui>/isEditable} }"/>
                                </VBox>
                            </f:content>
                        </f:SimpleForm>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="Compensation">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <f:SimpleForm layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="4" emptySpanM="4" columnsL="1" columnsM="1" editable="true">
                            <f:content>
                                <Label text="Monthly Salary"/>
                                <VBox>
                                    <Input value="{employees>Salary}" description="INR" visible="{ui>/isEditable}"/>
                                    <Text text="{employees>Salary} INR" visible="{= !${ui>/isEditable} }"/>
                                </VBox>
                            </f:content>
                        </f:SimpleForm>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>

        <uxap:footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button text="Save" type="Emphasized" press="onSave"/>
                <Button text="Cancel" type="Transparent" press="onEditToggle"/>
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>
